# Copia este archivo a `.env` y completa tus credenciales. `.env` está en .gitignore:
# NUNCA subas tus llaves al repositorio.

# --- The Movie Database (TMDB) ---------------------------------------------------------
# Crea la llave en https://www.themoviedb.org/settings/api indicando que son estudiantes del
# curso CC3116 de la Universidad del Valle de Guatemala y uso NO comercial.
# Acepta la API key v3 o el "API Read Access Token" v4 (empieza con eyJ).
TMDB_API_KEY=
TMDB_LANGUAGE=es-MX

# --- Google Books ----------------------------------------------------------------------
# Opcional: sin llave también funciona, con un límite de solicitudes más bajo.
# Se crea en https://console.cloud.google.com/apis/credentials (no requiere tarjeta).
GOOGLE_BOOKS_API_KEY=

# --- Modelo de lenguaje (LLM) ----------------------------------------------------------
# Proveedor del agente. Valores: anthropic | scripted (respuestas fijas, sin red; para pruebas).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento del modelo: low | medium | high.
LLM_EFFORT=low

# --- Servidor del agente ---------------------------------------------------------------
AGENT_PORT=8788
AGENT_HOST=127.0.0.1
# Orígenes (sitios) que pueden conectarse al WebSocket del agente, separados por comas.
AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AGENT_ASSISTANT_NAME=Sofía
# Mensajes por minuto permitidos por conexión.
AGENT_RATE_LIMIT_PER_MINUTE=12

# --- Servidor MCP de navegación (solo al usarlo desde un cliente MCP de escritorio) -----
# true = abre la pestaña en esta máquina además de devolver la acción open_url.
NAVIGATOR_OPEN_ON_HOST=false
